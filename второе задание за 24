#include <iostream>
using namespace std;

int main() {
const int N = 5;
int arr[N];

cout << "Введите 5 неотрицательных чисел:\n";

for (int i = 0; i < N; i++) {
cin >> arr[i];

while (arr[i] < 0) {
cout << "Ошибка! Введите неотрицательное число: ";
cin >> arr[i];
}
}

cout << "Введённый массив:\n";
for (int i = 0; i < N; i++) {
cout << arr[i] << " ";
}
