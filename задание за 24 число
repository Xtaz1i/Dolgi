#include <iostream>
using namespace std;

int main() {
double a, b, c;

cout << "Введите 3 числа:\n";
cin >> a >> b >> c;

if (a == 0 && b == 0 && c == 0) {
cout << "Все числа равны нулю.\n";
} else {
if (a == 0) cout << "Первое число равно нулю.\n";
if (b == 0) cout << "Второе число равно нулю.\n";
if (c == 0) cout << "Третье число равно нулю.\n";
}
double average = (a + b + c) / 3;
cout << "Среднее арифметическое: " << average << endl;

return 0;
}
