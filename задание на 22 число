#include <iostream>
using namespace std;

int main() {
const int N = 20;
int height[N];

cout << "Введите рост 20 учеников (в см):\n";
for (int i = 0; i < N; i++) {
cin >> height[i];
}

int sum = 0;
for (int i = 0; i < N; i++) {
sum += height[i];
}

double average = (double)sum / N;

int count = 0;
for (int i = 0; i < N; i++) {
if (height[i] > average) {
count++;
}
}

cout << "Средний рост: " << average << " см" << endl;
cout << "Количество учеников выше среднего: " << count << endl;

return 0;
}
